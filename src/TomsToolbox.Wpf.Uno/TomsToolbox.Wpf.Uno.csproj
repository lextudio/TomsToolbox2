<Project Sdk="Uno.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <OutputType>Library</OutputType>
    <!-- Produce the same assembly + namespaces as upstream TomsToolbox.Wpf so it
         is a drop-in for code that references TomsToolbox.Wpf on WinUI/Uno. -->
    <AssemblyName>TomsToolbox.Wpf</AssemblyName>
    <RootNamespace>TomsToolbox.Wpf</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UnoSingleProject>false</UnoSingleProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591;CS8618</NoWarn>
    <!-- ROMA_UNO guards HwndSource/PresentationSource methods in linked upstream files
         that have no WinUI/Uno equivalent (see DependencyObjectExtensions.cs). -->
    <DefineConstants>$(DefineConstants);ROMA_UNO</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TomsToolbox.Essentials\TomsToolbox.Essentials.csproj" />
    <ProjectReference Include="..\TomsToolbox.Composition\TomsToolbox.Composition.csproj" />
    <ProjectReference Include="..\TomsToolbox.ObservableCollections\TomsToolbox.ObservableCollections.csproj" />
    <ProjectReference Include="..\..\..\WindowsShims\src\LeXtudio.Windows\LeXtudio.Windows.csproj" />
  </ItemGroup>

  <!-- Portable source linked verbatim from the upstream TomsToolbox.Wpf project.
       System.Windows.* resolves to WindowsShims; the GlobalUsings dispatcher
       aliases map to System.Windows.Threading shims. -->
  <ItemGroup>
    <Compile Include="DispatcherExtensions.cs" />
    <Compile Include="Shims\DispatcherTimer.cs" />
    <Compile Include="Shims\AdvancedScrollWheelBehavior.cs" />
    <Compile Include="Shims\WeakEventHandlerMakeWeak.cs" />
    <Compile Include="..\TomsToolbox.Wpf\GlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="..\Nullable.cs" Link="Nullable.cs" />
    <Compile Include="..\TomsToolbox.Wpf\DelegateCommand.cs" Link="DelegateCommand.cs" />
    <Compile Include="..\TomsToolbox.Wpf\NullCommand.cs" Link="NullCommand.cs" />
    <Compile Include="..\TomsToolbox.Wpf\RelayedEventAttribute.cs" Link="RelayedEventAttribute.cs" />
    <Compile Include="..\TomsToolbox.Wpf\PropertyDependencyAttribute.cs" Link="PropertyDependencyAttribute.cs" />
    <Compile Include="..\TomsToolbox.Wpf\ObservableObjectBase.cs" Link="ObservableObjectBase.cs" />
    <Compile Include="..\TomsToolbox.Wpf\ObservableObjectBase.RelayedEvents.cs" Link="ObservableObjectBase.RelayedEvents.cs" />
    <Compile Include="..\TomsToolbox.Wpf\ObservableObject.cs" Link="ObservableObject.cs" />
    <Compile Include="..\TomsToolbox.Wpf\Throttle.cs" Link="Throttle.cs" />
    <!-- DependencyObjectExtensions: VisualAncestors/AncestorsAndSelf/TryFindAncestorOrSelf helpers.
         HwndSource/PresentationSource methods guarded by #if !ROMA_UNO in the upstream file. -->
    <Compile Include="..\TomsToolbox.Wpf\DependencyObjectExtensions.cs" Link="DependencyObjectExtensions.cs" />
    <!-- ExportProviderLocator: GetExportProvider(DependencyObject) extension used by ContextMenuEntry. -->
    <Compile Include="..\TomsToolbox.Wpf.Composition\ExportProviderLocator.cs" Link="ExportProviderLocator.cs" />
  </ItemGroup>

</Project>
